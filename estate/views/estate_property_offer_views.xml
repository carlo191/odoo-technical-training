<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.view.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="price"/>
                <button name="action_accept" type="object" string="Accept" icon="fa-check" invisible="status in ('accepted', 'refused')"/>
                <button name="action_refuse" type="object" string="Refuse" icon="fa-times" invisible="status in ('accepted', 'refused')"/>
                <field name="status" column_invisible="True"/>
                <field name="property_type_id"/>
                <field name="date_deadline"/>
                <field name="validity"/>
            </list>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.view.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_accept" type="object" string="Accept" class="oe_highlight" invisible="status in ('accepted', 'refused')"/>
                    <button name="action_refuse" type="object" string="Refuse" invisible="status in ('accepted', 'refused')"/>
                </header>
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="partner_id"/>
                        <field name="status"/>
                        <field name="property_id"/>
                        <field name="property_type_id"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>