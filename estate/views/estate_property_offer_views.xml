<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.view.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id" string="Proprieta"/>
                <field name="partner_id" string="Compratore"/>
                <field name="price" string="Prezzo"/>
                <button name="action_accept" type="object" string="Accetta" icon="fa-check" invisible="status in ('accepted', 'refused')"/>
                <button name="action_refuse" type="object" string="Rifiuta" icon="fa-times" invisible="status in ('accepted', 'refused')"/>
                <field name="status" column_invisible="True"/>
                <field name="property_type_id" string="Tipo"/>
                <field name="date_deadline" string="Scadenza"/>
                <field name="validity" string="Validita"/>
            </list>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.view.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_accept" type="object" string="Accetta" class="oe_highlight" invisible="status in ('accepted', 'refused')"/>
                    <button name="action_refuse" type="object" string="Rifiuta" invisible="status in ('accepted', 'refused')"/>
                </header>
                <sheet>
                    <group>
                        <field name="price" string="Prezzo"/>
                        <field name="partner_id" string="Compratore"/>
                        <field name="status" string="Stato"/>
                        <field name="property_id" string="Proprieta"/>
                        <field name="property_type_id" string="Tipo"/>
                        <field name="validity" string="Validita"/>
                        <field name="date_deadline" string="Scadenza"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Offerte</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
